# Application Port & Environment
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://rohanchristopher:@localhost:5432/limesurvey_modern?schema=public

# Legacy LimeSurvey Database (used for one-off import script)
LEGACY_DATABASE_URL=postgresql://rohanchristopher:@localhost:5432/limesurvey

# JWT Authentication
JWT_SECRET=replace_this_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Initial Admin User (used by npm run db:seed)
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Administrator
ADMIN_EMAIL=admin@limesurvey.local
ADMIN_PASSWORD=AdminPassword123!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10

# Docker Compose defaults (optional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=limesurvey_modern
POSTGRES_PORT=5432
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@limesurvey.local
PGADMIN_DEFAULT_PASSWORD=admin
