{
  "name": "limesurvey-clone",
  "version": "1.0.0",
  "private": true,
  "description": "Modern full-stack LimeSurvey migration (React 18, Node.js Express, PostgreSQL, Prisma)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:import-legacy": "npm run db:import-legacy --workspace=server",
    "db:studio": "npm run db:studio --workspace=server",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "test:api": "npm run test --workspace=server",
    "test:e2e": "playwright test",
    "lint": "eslint client/src server/src",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3"
  }
}
